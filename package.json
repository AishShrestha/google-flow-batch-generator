{
  "name": "google-flow-batch-generator",
  "version": "1.0.0",
  "description": "Batch image generation automation for Google Flow using Playwright",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "generate": "tsx src/index.ts generate",
    "generate:inspect": "tsx src/index.ts generate --inspect",
    "gen-prompts": "tsx src/index.ts gen-prompts",
    "gen-prompts:inspect": "tsx src/index.ts gen-prompts --inspect",
    "tts": "bash scripts/run-tts.sh",
    "setup-tts": "bash scripts/setup-tts.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["google-flow", "playwright", "automation", "image-generation"],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "playwright": "^1.45.0"
  },
  "devDependencies": {
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^22.0.0"
  }
}