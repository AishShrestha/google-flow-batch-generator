# Google Flow Batch Generator Configuration

# Google Flow URL
FLOW_URL=https://labs.google/fx/tools/flow

# Browser profile directory (persists Google login session)
BROWSER_PROFILE_DIR=.playwright-profile

# Output directory for generated images
OUTPUT_DIR=output

# Generation timeout in milliseconds (default: 180 seconds)
GENERATION_TIMEOUT_MS=180000

# Maximum retry attempts per prompt
MAX_RETRIES=3

# Delay between prompts in milliseconds
DELAY_BETWEEN_PROMPTS_MS=3000

# Run browser in headless mode (false = visible browser)
HEADLESS=false

# Number of images to download per prompt (if Google Flow generates multiple)
MAX_IMAGES_PER_PROMPT=4

# Browser viewport width
VIEWPORT_WIDTH=1280

# Browser viewport height
VIEWPORT_HEIGHT=800