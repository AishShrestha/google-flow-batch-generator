# Google Flow Batch Generator Configuration

# Google Flow URL
FLOW_URL=https://labs.google/fx/tools/flow

# Browser profile directory (persists Google login session)
BROWSER_PROFILE_DIR=.playwright-profile

# Output directory for generated images
OUTPUT_DIR=output

# Generation timeout in milliseconds (default: 180 seconds)
GENERATION_TIMEOUT_MS=180000

# Maximum retry attempts per prompt
MAX_RETRIES=3

# Delay between prompts in milliseconds
DELAY_BETWEEN_PROMPTS_MS=3000

# Run browser in headless mode (false = visible browser)
HEADLESS=false

# Number of images to download per prompt (if Google Flow generates multiple)
MAX_IMAGES_PER_PROMPT=4

# Browser viewport width
VIEWPORT_WIDTH=1280

# Browser viewport height
VIEWPORT_HEIGHT=800

# ─── Gemini Prompt Generation ─────────────────────────────────────
# Gemini chat URL
GEMINI_URL=https://gemini.google.com/app

# Separate profile for Gemini (parallel with Flow)
GEMINI_PROFILE_DIR=.gemini-profile

# Model name as shown in Gemini UI picker (3.1 Pro, 3.7 Flash, 3.5 Flash-Lite)
GEMINI_MODEL=3.1 Pro

# Fallback model if primary hits rate limit
GEMINI_FALLBACK_MODEL=3.7 Flash

# Lines per batch (match master prompt's 20-line chunking)
GEMINI_BATCH_SIZE=20

# Timeout per Gemini response in milliseconds (default: 120 seconds)
GEMINI_TIMEOUT_MS=120000

# Run Gemini browser in headless mode (false = visible)
GEMINI_HEADLESS=false

# Gemini browser viewport
GEMINI_VIEWPORT_WIDTH=1280
GEMINI_VIEWPORT_HEIGHT=800